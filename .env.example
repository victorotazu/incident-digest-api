# Static bearer token required for API authentication (Authorization: Bearer <token>)
API_BEARER_TOKEN=replace-with-your-static-bearer-token

# Google Gemini Configuration
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# LLM Runtime Guardrails
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=500
